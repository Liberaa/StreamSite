# Copy this file to .env and adjust the values.

NODE_ENV=development
PORT=3000
APP_NAME=StreamSite

# Local MongoDB. For MongoDB Atlas, paste your mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/streamsite

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Set to true when running behind a reverse proxy (nginx, Render, Railway...).
TRUST_PROXY=false

# --- Media server (node-media-server) ---
# OBS sends video to the RTMP port; browsers watch over the HTTP port.
RTMP_PORT=1935
MEDIA_HTTP_PORT=8000
MEDIA_BIND=0.0.0.0
# trace | debug | info | warn | error
MEDIA_LOG_LEVEL=warn

# Only needed when the media server is reachable at a different public address,
# for example behind a proxy or on its own domain.
# MEDIA_PUBLIC_URL=https://media.example.com
# RTMP_PUBLIC_URL=rtmp://ingest.example.com/live
