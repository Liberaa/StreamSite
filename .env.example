# Copy this file to .env and adjust the values.

NODE_ENV=development
PORT=3000
APP_NAME=StreamSite

# Local MongoDB. For MongoDB Atlas, paste your mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/streamsite

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Set to true when running behind a reverse proxy (nginx, Render, Railway...).
TRUST_PROXY=false

# --- Media server (node-media-server) ---
# OBS sends video to the RTMP port; browsers watch over the HTTP port.
RTMP_PORT=1935
MEDIA_HTTP_PORT=8000
MEDIA_BIND=0.0.0.0
# trace | debug | info | warn | error
MEDIA_LOG_LEVEL=warn

# Viewers get video through the website itself (/live/<name>.flv), so the
# media HTTP port does not need to be public. Set MEDIA_PUBLIC_URL only to
# serve video from a separate media server or CDN instead.
# MEDIA_PUBLIC_URL=https://media.example.com
# The OBS and phone-app server address, when it differs from the site address.
# RTMP_PUBLIC_URL=rtmp://ingest.example.com/live

# --- Streaming from phones and browsers ---
# Development only: an https server so a phone on the same Wi-Fi can use its
# camera (browsers only allow it on https). Leave empty to turn it off.
DEV_HTTPS_PORT=3443
# Browser streaming relays video through ffmpeg. The ffmpeg-static package
# provides it; point this at another ffmpeg if you prefer.
# FFMPEG_PATH=/usr/bin/ffmpeg
# How many creators may stream from a browser at the same time. Each one
# uses about one CPU core for video encoding.
BROWSER_STREAM_LIMIT=4
